{
  "name": "k-hakdang",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "android:bootstrap": "powershell -ExecutionPolicy Bypass -File scripts/capacitor-bootstrap.ps1",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:bundle:release": "powershell -ExecutionPolicy Bypass -File scripts/android-release-build.ps1",
    "prepare:privacy-policy": "node scripts/generate-privacy-policy.cjs",
    "test:e2e": "node scripts/run-ai-test.cjs",
    "report:daily": "node scripts/daily-report.cjs",
    "check:android-preflight": "node scripts/android-preflight-check.cjs",
    "check:release-readiness": "node scripts/release-readiness-check.cjs",
    "report:quiz-metadata": "node scripts/quiz-metadata-report.cjs",
    "report:quiz-metadata:history-proverbs-worklist": "node scripts/quiz-metadata-report.cjs --only-category=history --only-category=proverbs --worklist=.claude/quiz-metadata-worklist.md",
    "report:quiz-metadata:idioms-worklist": "node scripts/quiz-metadata-report.cjs --only-category=idioms --worklist=.claude/quiz-metadata-worklist.md",
    "report:quiz-metadata:quiz-worklist": "node scripts/quiz-metadata-report.cjs --only-category=quiz --worklist=.claude/quiz-metadata-worklist.md",
    "check:quiz-metadata": "node scripts/quiz-metadata-report.cjs --strict --min-complete=42",
    "check:quiz-metadata:history-proverbs": "node scripts/quiz-metadata-report.cjs --strict --min-complete=92 --require-category-complete=history:30 --require-category-complete=proverbs:30",
    "check:quiz-metadata:idioms-complete": "node scripts/quiz-metadata-report.cjs --strict --min-complete=206 --require-category-complete=idioms:30",
    "check:quiz-metadata:idioms-target": "node scripts/quiz-metadata-report.cjs --strict --min-complete=140 --require-category-complete=idioms:24",
    "check:quiz-metadata:quiz-target": "node scripts/quiz-metadata-report.cjs --strict --min-complete=170 --require-category-complete=quiz:66"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.9",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
